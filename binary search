import time

# Binary Search Function
def binary_search(arr, key):
    low = 0
    high = len(arr) - 1

    while low <= high:
        mid = (low + high) // 2

        if arr[mid] == key:
            return mid
        elif arr[mid] < key:
            low = mid + 1
        else:
            high = mid - 1

    return -1

# Main Program
n = int(input("Enter the number of elements: "))

arr = []

print("Enter", n, "elements:")
for i in range(n):
    num = int(input(f"Element {i+1}: "))
    arr.append(num)

# Sort the array (Binary Search requires sorted array)
arr.sort()

print("\nSorted Array:", arr)

key = int(input("\nEnter the element to search: "))

# Start Time
start = time.time()

index = binary_search(arr, key)

# End Time
end = time.time()

# Output
if index != -1:
    print(f"\nElement {key} found at index {index}.")
else:
    print(f"\nElement {key} not found.")

print("\nExecution Time: {:.8f} seconds".format(end - start))

print("\nTime Complexity:")
print("Best Case    : O(1)")
print("Average Case : O(log n)")
print("Worst Case   : O(log n)")
print("Space Complexity : O(1)")
